{
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "import": [
    "./node_modules/@cspell/dict-pt-br/cspell-ext.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "profile-terms",
      "path": "./.cspell/profile-terms.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "profile-terms"
  ],
  "overrides": [
    {
      "filename": "README.md",
      "language": "pt_BR,en-US",
      "dictionaries": [
        "pt-br",
        "profile-terms"
      ]
    },
    {
      "filename": "README.en.md",
      "language": "en-US",
      "dictionaries": [
        "profile-terms"
      ]
    }
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "Base64"
  ]
}
